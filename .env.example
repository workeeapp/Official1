# PostgreSQL connection string
DATABASE_URL=postgresql://workee:workee@localhost:5432/workee

# Secret used to sign authentication cookies (min 32 characters)
AUTH_SECRET=replace-with-a-long-random-secret-key

# API server
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Seeded local user (optional; used only by `npm run db:seed`)
SEED_USERNAME=Amit
SEED_PASSWORD=ChangeMe123!

# OpenAI (required for Chat). Model, temperature, and system message live in LLM.config or LLM.config.json
OPENAI_API_KEY=

# WhatsApp Cloud API (optional). Do not commit real tokens.
# Webhook: https://<public-host>/api/whatsapp/webhook
# VERIFY_TOKEN = invented string (not the EAA / system-user token)
# ACCESS_TOKEN = system-user token for multi-day use
# DEFAULT_EMPLOYEE = human nickname/name used when the sender phone is unknown
# After pull: prisma migrate deploy (WhatsAppInbounds stores last inbound for the 24h session window)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DEFAULT_EMPLOYEE=
# Public WhatsApp business number (E.164 digits) for wa.me cold-invite links
# Optional: Amit's «שלח בוואטסאפ» compose button works without this; set it so the
# draft includes a business link for the recipient → לוסי-אורח guest loop.
WHATSAPP_DISPLAY_PHONE=

# Tips admin UI — WhatsApp preview destination for the per-tip Send button (digits / E.164).
TIPS_PREVIEW_PHONE=

# Attachments (WhatsApp media). Bytes are stored on disk; relative paths resolve from the backend cwd.
UPLOADS_DIR=.data/uploads
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Google Places API (New) key (optional). Enable Places API (New) on the GCP project.
# Also enable Geocoding API on the same key for Places geo_mode=area_restrict
# (hard inside-area viewport → locationRestriction). Soft city search needs Places only.
# Live local business search («תמצאי לי חשמלאי…» / near-me with WhatsApp pin).
GOOGLE_PLACES_API_KEY=
# Max results per Places Text Search (1–20, default 10).
GOOGLE_PLACES_MAX_RESULTS=10

# Google Routes API key (optional). Enable Routes API on the GCP project.
# Public-transit A→B, leave-by, next departure, headway, bus_eta watches.
# Falls back to GOOGLE_PLACES_API_KEY when unset.
GOOGLE_ROUTES_API_KEY=

# MOT GTFS static schedule / nearest_stop / stop-name→code (optional).
# Requires an active ingested generation (npm run ingest:gtfs or equivalent).
# GTFS_ENABLED=1

# MOT SIRI-SM live stop arrivals (optional). Kill switch + base URL + key.
# SIRI_ENABLED=1
# SIRI_SM_BASE_URL=
# SIRI_SM_KEY=

# AviationStack (optional). Live airport boards + flight status / watches.
# Free tier ~100 req/month — https://aviationstack.com/
AVIATIONSTACK_ACCESS_KEY=
