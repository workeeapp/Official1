# PostgreSQL connection string
DATABASE_URL=postgresql://workee:workee@localhost:5432/workee

# Secret used to sign authentication cookies (min 32 characters)
AUTH_SECRET=replace-with-a-long-random-secret-key

# API server
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Seeded local login user(s). Comma-separated usernames share SEED_PASSWORD.
# Example: SEED_USERNAME=Amit,Tal
SEED_USERNAME=Amit
SEED_PASSWORD=ChangeMe123!
# Comma-separated login usernames that get Users.is_admin=true on seed (Admin tab).
# Runtime reads the DB flag — not this env on every request. Admin ≠ Employee.isOwner.
SEED_ADMIN_USERNAMES=Amit

# OpenAI (required for Chat). Model, temperature, and system message live in LLM.config or LLM.config.json
OPENAI_API_KEY=

# WhatsApp Cloud API (optional). Do not commit real tokens.
# Webhook: https://<public-host>/api/whatsapp/webhook
# VERIFY_TOKEN = invented string (not the EAA / system-user token)
# ACCESS_TOKEN = system-user token for multi-day use
# DEFAULT_EMPLOYEE = human nickname/name used when the sender phone is unknown
# After pull: prisma migrate deploy (WhatsAppInbounds stores last inbound for the 24h session window)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DEFAULT_EMPLOYEE=

# POC ops monitoring — phones + mode. See docs/ops-monitoring.md
# MODE: off (default) = never WhatsApp; critical = system-down only (e.g. DB);
#       all = alertable app failures (skips Meta allow-list noise).
OPS_ALERT_PHONES=
OPS_ALERT_MODE=off
OPS_ALERT_COOLDOWN_MINUTES=30
# Admin status-board: ignore failures older than this many minutes (history list keeps them).
OPS_STATUS_LOOKBACK_MINUTES=60

# Admin CI dashboard (optional). PAT / fine-grained token with actions:read.
# Empty = CI section shows “not configured”. Repo defaults from git remote origin.
GITHUB_TOKEN=
GITHUB_REPO=
