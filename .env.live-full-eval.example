# Copy to .env.live-full-eval (gitignored) and set strong passwords.
# Used only by:
#   docker compose -f docker-compose.live-full-eval.yml --env-file .env.live-full-eval up -d
#   . .\scripts\Load-LiveFullEvalEnv.ps1
#   npm run test:eval-db -w backend -- <suite>   # vitest.eval-db.config.ts (fail-closed)
# Never replace shared product .env (port 5435 / database workee).
# DATABASE_URL must exactly equal WORKEE_APPROVED_TEST_DATABASE_URL (no product fallback).

WORKEE_BOOTSTRAP_PASSWORD=change-me-bootstrap
WORKEE_EVAL_PASSWORD=change-me-eval

# After init, set these to the same URL (workee_eval @ localhost:5436 / workee_test):
# DATABASE_URL=postgresql://workee_eval:CHANGE_ME@127.0.0.1:5436/workee_test
# WORKEE_APPROVED_TEST_DATABASE_URL=<exact same as DATABASE_URL>
# WORKEE_DISABLE_WHATSAPP_OUTBOUND=1
# WORKEE_DISABLE_REMINDER_FIRE=1
# Optional: enable MOT GTFS schedule/nearest_stop queries after a successful ingest
# GTFS_ENABLED=1
# Optional: MOT SIRI-SM live_arrivals (never invent base URL; key from MOT email only)
# SIRI_ENABLED=1
# SIRI_SM_BASE_URL=
# SIRI_SM_KEY=
