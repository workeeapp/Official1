generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  /** Null for WhatsApp-only accounts created via guest registration. */
  username     String?    @unique @db.VarChar(32)
  /** Null for WhatsApp-only accounts; web login impossible until set. */
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  teams             Team[]
  employees         Employee[]
  chatConversations ChatConversation[]
  contacts          Contact[]
  contactBooks      ContactBook[]
  tips              Tip[]
  whatsappInvites   WhatsAppInvite[]

  @@map("Users")
}

/**
 * Account teams. A User may have a personal team plus the shared
 * "New Registered 30 days" bucket for new registrants. Guests have no team.
 */
model Team {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  /** Null when the account has no username (WhatsApp-only personal team). */
  name      String?    @db.VarChar(100)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@index([userId])
  @@index([userId, name])
  @@map("Teams")
}

model Employee {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  /** Null for WhatsApp guest shells (`isGuest`); otherwise a team on the account (personal or shared registered). */
  teamId       String?  @map("team_id") @db.Uuid
  kind         String   @default("human") @db.VarChar(16)
  name         String   @db.VarChar(100)
  surname      String   @db.VarChar(100)
  nickname     String?  @db.VarChar(100)
  email        String?  @db.VarChar(254)
  /** Canonical digits (IL `0…` stored as `972…`). Globally unique when set. */
  phone        String?  @unique @db.VarChar(32)
  model        String?  @db.VarChar(100)
  temperature  Float?
  reasoningEffort String? @map("reasoning_effort") @db.VarChar(16)
  instructions String?  @db.Text
  isProtected  Boolean  @default(false) @map("is_protected")
  isOwner      Boolean  @default(false) @map("is_owner")
  /** WhatsApp outsider shell — not a team member. Digitals are never guests. */
  isGuest      Boolean  @default(false) @map("is_guest")
  /** How Lucy addresses this human in Hebrew: male | female | null (ask once). */
  addressGender String?  @map("address_gender") @db.VarChar(16)
  /**
   * Registered member → host-account employee kept on shared lists (same id that
   * was the WhatsApp guest). Null when not linked.
   */
  shareMirrorEmployeeId String?  @map("share_mirror_employee_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  user                     User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  team                     Team?              @relation(fields: [teamId], references: [id], onDelete: Restrict)
  shareMirrorEmployee      Employee?          @relation("ShareMirror", fields: [shareMirrorEmployeeId], references: [id], onDelete: SetNull)
  mirroredBy               Employee[]         @relation("ShareMirror")
  chatConversations        ChatConversation[] @relation("ConversationSpeaker")
  digitalChatConversations ChatConversation[] @relation("ConversationPartner")
  lists                    EmployeeList[]
  filings                  EmployeeFiling[]
  ownedReminders           Reminder[]         @relation("ReminderOwner")
  actedReminders           Reminder[]         @relation("ReminderActor")
  contacts                 Contact[]
  contactBook              ContactBook?
  attachments              Attachment[]
  tipsTargeted             Tip[]              @relation("TipDigital")
  tipProgressAsSpeaker     TipProgress[]      @relation("TipProgressSpeaker")
  tipProgressAsDigital     TipProgress[]      @relation("TipProgressDigital")

  @@index([userId])
  @@index([teamId])
  @@index([shareMirrorEmployeeId])
  @@map("Employees")
}

/// Contextual / general tips the engine may append after a digital-worker reply.
model Tip {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  /** Stable key for metadata.tips (e.g. guest_terms). Unique per account. */
  key               String    @db.VarChar(64)
  /** guest | member | any */
  audience          String    @db.VarChar(16)
  /** null = any digital on this account; else only that worker. */
  digitalEmployeeId String?   @map("digital_employee_id") @db.Uuid
  /** action | model | general */
  triggerKind       String    @map("trigger_kind") @db.VarChar(16)
  /** When triggerKind=action: reminders | filing | lists | directory */
  triggerArea       String?   @map("trigger_area") @db.VarChar(32)
  /** When triggerKind=action: add | remove | update */
  triggerOp         String?   @map("trigger_op") @db.VarChar(16)
  /** basic | intermediate | advanced | personal */
  tier              String    @default("basic") @db.VarChar(16)
  /** Product topic: shopping | tasks | custom | filing | reminders | directory | guest */
  topic             String?   @db.VarChar(32)
  /** Match applied list_type when set (shopping|tasks|custom|contacts|filing|reminders). */
  listType          String?   @map("list_type") @db.VarChar(32)
  /** Optional: require this tip key shown first (else unlock by prior tier in topic). */
  unlockAfterKey    String?   @map("unlock_after_key") @db.VarChar(64)
  /** Catalog seed — upserted in place by ensureDefaultTips; UI edits set false. */
  systemSeed        Boolean   @default(false) @map("system_seed")
  /** static = Tip.text is final copy; dynamic = Tip.text is instructions + turn FACTS compose. */
  outputMode        String    @default("static") @map("output_mode") @db.VarChar(16)
  /** Min minutes between shows for the same speaker×digital (0 = no cooldown). */
  minIntervalMinutes Int      @default(0) @map("min_interval_minutes")
  maxShows          Int       @default(1) @map("max_shows")
  order             Int       @default(0)
  text              String    @db.Text
  enabled           Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  digitalEmployee   Employee? @relation("TipDigital", fields: [digitalEmployeeId], references: [id], onDelete: SetNull)
  progress          TipProgress[]

  @@unique([userId, key])
  @@index([userId, enabled])
  @@index([digitalEmployeeId])
  @@index([userId, topic, tier])
  @@map("Tips")
}

/// How many times a tip was shown to a speaker by a given digital worker.
model TipProgress {
  id                String   @id @default(uuid()) @db.Uuid
  tipId             String   @map("tip_id") @db.Uuid
  employeeId        String   @map("employee_id") @db.Uuid
  digitalEmployeeId String   @map("digital_employee_id") @db.Uuid
  showCount         Int      @default(0) @map("show_count")
  lastShownAt       DateTime @default(now()) @map("last_shown_at")
  tip               Tip      @relation(fields: [tipId], references: [id], onDelete: Cascade)
  employee          Employee @relation("TipProgressSpeaker", fields: [employeeId], references: [id], onDelete: Cascade)
  digitalEmployee   Employee @relation("TipProgressDigital", fields: [digitalEmployeeId], references: [id], onDelete: Cascade)

  @@unique([tipId, employeeId, digitalEmployeeId])
  @@index([employeeId, digitalEmployeeId])
  @@map("TipProgress")
}

model ChatConversation {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  employeeId           String        @map("employee_id") @db.Uuid
  digitalEmployeeId    String        @map("digital_employee_id") @db.Uuid
  openaiConversationId String        @map("openai_conversation_id") @db.VarChar(255)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  user                 User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  employee             Employee      @relation("ConversationSpeaker", fields: [employeeId], references: [id], onDelete: Cascade)
  digitalEmployee      Employee      @relation("ConversationPartner", fields: [digitalEmployeeId], references: [id], onDelete: Cascade)
  contextInjectedAt    DateTime?     @map("context_injected_at")
  messages             ChatMessage[]
  llmUsages            LlmUsage[]

  @@unique([userId, employeeId, digitalEmployeeId])
  @@index([userId])
  @@index([digitalEmployeeId])
  @@map("ChatConversations")
}

model ChatMessage {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  author         String           @db.VarChar(16)
  speaker        String           @db.VarChar(100)
  text           String           @db.Text
  actions        Json?
  buttons        Json?
  navigateAddress String?         @map("navigate_address") @db.VarChar(300)
  /// wa.me compose URL for the speaker to open personal WhatsApp (cold invite).
  whatsappComposeUrl String?      @map("whatsapp_compose_url") @db.VarChar(2000)
  /// Emoji reaction on the speaker bubble (metadata.show_icon).
  showIcon       String?          @map("show_icon") @db.VarChar(32)
  /// Files shown on this bubble: [{ id, kind, file_name }].
  attachments    Json?
  raw            Json?
  createdAt      DateTime         @default(now()) @map("created_at")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ChatMessages")
}

model LlmUsage {
  id                   String           @id @default(uuid()) @db.Uuid
  conversationId       String           @map("conversation_id") @db.Uuid
  employeeId           String           @map("employee_id") @db.Uuid
  digitalEmployeeId    String           @map("digital_employee_id") @db.Uuid
  openaiConversationId String           @map("openai_conversation_id") @db.VarChar(255)
  responseId           String?          @map("response_id") @db.VarChar(255)
  model                String           @db.VarChar(100)
  inputTokens          Int              @default(0) @map("input_tokens")
  outputTokens         Int              @default(0) @map("output_tokens")
  cachedTokens         Int              @default(0) @map("cached_tokens")
  reasoningTokens      Int              @default(0) @map("reasoning_tokens")
  totalTokens          Int              @default(0) @map("total_tokens")
  costUsd              Decimal?         @map("cost_usd") @db.Decimal(14, 8)
  priceModel           String?          @map("price_model") @db.VarChar(100)
  /** chat | catalog_tip | weather_tip | reminder_compose | live_select */
  purpose              String           @default("chat") @db.VarChar(32)
  usage                Json?
  createdAt            DateTime         @default(now()) @map("created_at")
  conversation         ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([employeeId, createdAt])
  @@index([digitalEmployeeId, createdAt])
  @@index([purpose, createdAt])
  @@map("LlmUsages")
}

/// USD per 1M tokens (standard tier). `input_tokens` from OpenAI includes cached tokens.
model LlmModelPrice {
  id                 String   @id @default(uuid()) @db.Uuid
  model              String   @unique @db.VarChar(100)
  inputPer1m         Decimal  @map("input_usd_per_1m") @db.Decimal(12, 6)
  cachedInputPer1m   Decimal  @map("cached_input_usd_per_1m") @db.Decimal(12, 6)
  cacheWritePer1m    Decimal? @map("cache_write_usd_per_1m") @db.Decimal(12, 6)
  outputPer1m        Decimal  @map("output_usd_per_1m") @db.Decimal(12, 6)
  currency           String   @default("USD") @db.VarChar(3)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("LlmModelPrices")
}

model EmployeeList {
  id         String             @id @default(uuid()) @db.Uuid
  employeeId String             @map("employee_id") @db.Uuid
  listType   String             @map("list_type") @db.VarChar(32)
  name       String             @default("") @db.VarChar(100)
  /// Display emoji override; null = canonical default (🛒/✅/👤/📋) at read time.
  emoji      String?            @db.VarChar(32)
  /// Custom lists: data key that names each row (set by the model when the list is created).
  titleField String             @default("") @map("title_field") @db.VarChar(100)
  /// Custom lists: declared column names, in order.
  columns    Json               @default("[]")
  /// Custom lists: removed columns. Values stay in item data but are hidden from the model and UI.
  hiddenColumns Json            @default("[]") @map("hidden_columns")
  scope      String             @default("personal") @db.VarChar(16)
  visibleTo  Json               @default("[]") @map("visible_to")
  deletedAt  DateTime?          @map("deleted_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items      EmployeeListItem[]
  attachmentLinks AttachmentLink[]
  /** Shopping/custom lists linked FROM task items (many-to-many). */
  linkedFromItems ListItemListLink[]

  /// Name uniqueness is a partial index (deleted_at IS NULL) in the migration.
  @@index([employeeId, listType, name])
  @@index([employeeId])
  @@index([scope])
  @@index([deletedAt])
  @@map("EmployeeLists")
}

model EmployeeListItem {
  id         String       @id @default(uuid()) @db.Uuid
  listId     String       @map("list_id") @db.Uuid
  itemKey    String       @map("item_key") @db.VarChar(255)
  data       Json
  scope      String       @default("personal") @db.VarChar(16)
  addedById  String?      @map("added_by_id") @db.Uuid
  visibleTo  Json         @default("[]") @map("visible_to")
  /** normal | urgent | very_urgent — list items from lists[].items[].urgency; open jobs from messages[].urgency. */
  urgency    String       @default("normal") @db.VarChar(16)
  deletedAt  DateTime?    @map("deleted_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  list          EmployeeList @relation(fields: [listId], references: [id], onDelete: Cascade)
  reminderId    String?      @unique @map("reminder_id") @db.Uuid
  reminderClock Reminder?    @relation("ClockOwnsTask", fields: [reminderId], references: [id], onDelete: Cascade)
  ownedClock    Reminder?    @relation("TaskOwnsClock")
  /** Same-turn clock for a speaker/shared item; deleting the clock keeps the item. */
  linkedReminderId String?   @map("linked_reminder_id") @db.Uuid
  linkedReminder   Reminder? @relation("ClockLinksItem", fields: [linkedReminderId], references: [id], onDelete: SetNull)
  /** Many clocks per speaker/shopping item (one item per clock). */
  reminderLinks    EmployeeListItemReminderLink[]
  attachmentLinks  AttachmentLink[]
  /** Task hosts: shopping/custom lists linked to this item. */
  linkedLists      ListItemListLink[]

  @@index([listId, itemKey])
  @@index([linkedReminderId])
  @@index([scope])
  @@index([deletedAt])
  @@map("EmployeeListItems")
}

/// Many clocks ↔ one speaker/shopping item; each clock links to at most one item.
model EmployeeListItemReminderLink {
  id         String           @id @default(uuid()) @db.Uuid
  listItemId String           @map("list_item_id") @db.Uuid
  reminderId String           @map("reminder_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at")
  listItem   EmployeeListItem @relation(fields: [listItemId], references: [id], onDelete: Cascade)
  reminder   Reminder         @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@unique([listItemId, reminderId])
  @@unique([reminderId])
  @@index([listItemId])
  @@map("EmployeeListItemReminderLinks")
}

/// Many-to-many: a tasks item hosts links to shopping/custom lists.
model ListItemListLink {
  id         String           @id @default(uuid()) @db.Uuid
  listItemId String           @map("list_item_id") @db.Uuid
  listId     String           @map("list_id") @db.Uuid
  addedById  String?          @map("added_by_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at")
  listItem   EmployeeListItem @relation(fields: [listItemId], references: [id], onDelete: Cascade)
  list       EmployeeList     @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listItemId, listId])
  @@index([listItemId])
  @@index([listId])
  @@map("ListItemListLinks")
}

model EmployeeFiling {
  id              String    @id @default(uuid()) @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  itemName        String    @map("item_name") @db.VarChar(200)
  itemInfo        String    @map("item_info") @db.Text
  itemDescription String    @default("") @map("item_description") @db.Text
  addedById       String?   @map("added_by_id") @db.Uuid
  scope           String    @default("personal") @db.VarChar(16)
  visibleTo       Json      @default("[]") @map("visible_to")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attachmentLinks AttachmentLink[]

  @@index([employeeId, itemName])
  @@index([employeeId])
  @@index([deletedAt])
  @@index([scope])
  @@map("EmployeeFilings")
}

model Reminder {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  itemKey   String   @map("item_key") @db.VarChar(255)
  itemLabel String   @map("item_label") @db.VarChar(255)
  listType  String   @map("list_type") @db.VarChar(32)
  fireAt    DateTime @map("fire_at")
  repeat    String   @default("once") @db.VarChar(32)
  /** Structured repeat rule from the model (freq/interval/weekdays/month_day/month/time/until/count). Wins over `repeat`. */
  recurrence Json?
  /** Occurrences fired so far — enforces recurrence.count. */
  occurrencesFired Int @default(0) @map("occurrences_fired")
  pingIds     Json     @default("[]") @map("ping_ids")
  /** Employee ids the clock is about (birthday of X) — not who gets WhatsApp (ping_ids). */
  aboutIds    Json     @default("[]") @map("about_ids")
  messageText String   @default("") @map("message_text") @db.Text
  composeAtFire Boolean @default(false) @map("compose_at_fire")
  /** Empty = normal compose brief; "git_log" | "saved_data" | "weather" | "market" | "mashov" = facts plugin at fire. */
  composeSource String @default("") @map("compose_source") @db.VarChar(32)
  /** Hours of git history for windowed digests (0 = recurring since-last-report mode). Supports fractions (e.g. 0.083 ≈ 5 minutes). */
  composeLookbackHours Float @default(0) @map("compose_lookback_hours")
  /** weather: city; market: tickers; mashov: child name; jewish_candles: city. */
  composePlace String @default("") @map("compose_place") @db.VarChar(255)
  /**
   * Event-relative schedule: empty = wall clock; "jewish_candles" = fire from
   * next Hebcal candle lighting + schedule_offset_minutes (city in compose_place).
   */
  scheduleAnchor String @default("") @map("schedule_anchor") @db.VarChar(32)
  /** Minutes relative to the schedule anchor (negative = before). */
  scheduleOffsetMinutes Int @default(0) @map("schedule_offset_minutes")
  /**
   * Conditional watch: only send WhatsApp when the condition holds at fire.
   * e.g. {type:"market_price",op:"lt",value:80000} | {type:"weather_rain"} | {type:"mashov_new"}.
   */
  composeCondition Json? @map("compose_condition")
  /**
   * One-shot conditional watch: after a successful condition send, settle as done
   * (soft-delete Lucy worker task). Quiet skips still advance fire_at.
   */
  watchOnce Boolean @default(false) @map("watch_once")
  /**
   * Optional aspects for compose plugins at fire (weather/market/mashov), e.g.
   * ["grades","behavior","homework","absences","messages"].
   */
  composeAspects Json? @map("compose_aspects")
  lastComposedText String @default("") @map("last_composed_text") @db.Text
  /**
   * HEAD sha after the last git digest fire; also market edge state
   * (market:below / market:above) or mashov/weather content fingerprint.
   */
  lastReportSha String @default("") @map("last_report_sha") @db.VarChar(64)
  status      String   @default("active") @db.VarChar(16)
  sendStatus  String   @default("pending") @map("send_status") @db.VarChar(16)
  sentAt      DateTime? @map("sent_at")
  workerItemId String?   @unique @map("worker_item_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  owner     Employee @relation("ReminderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  actor     Employee @relation("ReminderActor", fields: [actorId], references: [id], onDelete: Restrict)
  workerItem EmployeeListItem? @relation("TaskOwnsClock", fields: [workerItemId], references: [id], onDelete: Cascade)
  ownedTask  EmployeeListItem? @relation("ClockOwnsTask")
  linkedItems EmployeeListItem[] @relation("ClockLinksItem")
  itemLinks   EmployeeListItemReminderLink[]
  attachmentLinks AttachmentLink[]

  @@index([userId, status, fireAt])
  @@index([ownerId, itemKey])
  @@map("Reminders")
}

/// A file the speaker sent (WhatsApp media). Bytes live in attachment storage under `storage_key`.
model Attachment {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  uploaderId           String    @map("uploader_id") @db.Uuid
  /** image | video | audio | document | sticker */
  kind                 String    @db.VarChar(16)
  mimeType             String    @map("mime_type") @db.VarChar(127)
  fileName             String    @default("") @map("file_name") @db.VarChar(255)
  sizeBytes            Int       @default(0) @map("size_bytes")
  sha256               String    @default("") @db.VarChar(64)
  storageKey           String    @map("storage_key") @db.VarChar(300)
  caption              String    @default("") @db.Text
  /** Voice/audio transcription. */
  transcript           String    @default("") @db.Text
  /**
   * STT outcome for audio: ok | empty | unavailable | error.
   * Null = legacy row (pre-status) — do not invent a failure in facts.
   */
  transcriptStatus     String?   @map("transcript_status") @db.VarChar(16)
  waInboundMediaId     String    @default("") @map("wa_inbound_media_id") @db.VarChar(128)
  /** Media id from our own upload to WhatsApp (valid about 30 days). */
  waOutboundMediaId    String    @default("") @map("wa_outbound_media_id") @db.VarChar(128)
  waOutboundUploadedAt DateTime? @map("wa_outbound_uploaded_at")
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  uploader             Employee  @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  links                AttachmentLink[]

  @@index([userId, createdAt])
  @@index([uploaderId, createdAt])
  @@map("Attachments")
}

/// Exactly one target per row (SQL CHECK in the migration).
model AttachmentLink {
  id           String            @id @default(uuid()) @db.Uuid
  attachmentId String            @map("attachment_id") @db.Uuid
  listId       String?           @map("list_id") @db.Uuid
  listItemId   String?           @map("list_item_id") @db.Uuid
  filingId     String?           @map("filing_id") @db.Uuid
  reminderId   String?           @map("reminder_id") @db.Uuid
  contactId    String?           @map("contact_id") @db.Uuid
  addedById    String?           @map("added_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at")
  attachment   Attachment        @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  list         EmployeeList?     @relation(fields: [listId], references: [id], onDelete: Cascade)
  listItem     EmployeeListItem? @relation(fields: [listItemId], references: [id], onDelete: Cascade)
  filing       EmployeeFiling?   @relation(fields: [filingId], references: [id], onDelete: Cascade)
  reminder     Reminder?         @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  contact      Contact?          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([attachmentId, listId])
  @@unique([attachmentId, listItemId])
  @@unique([attachmentId, filingId])
  @@unique([attachmentId, reminderId])
  @@unique([attachmentId, contactId])
  @@index([listId])
  @@index([listItemId])
  @@index([filingId])
  @@index([reminderId])
  @@index([contactId])
  @@map("AttachmentLinks")
}

model AuditEvent {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  actorEmployeeId  String?  @map("actor_employee_id") @db.Uuid
  action           String   @db.VarChar(64)
  entityType       String   @map("entity_type") @db.VarChar(64)
  entityId         String?  @map("entity_id") @db.Uuid
  summary          String   @db.VarChar(500)
  detail           Json?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("AuditEvents")
}

model WhatsAppInbound {
  phone         String   @id @db.VarChar(32)
  lastInboundAt DateTime @map("last_inbound_at")

  @@map("WhatsAppInbounds")
}

// Whole phone-book co-share (like contacts list participants). Row share stays on Contact.
model ContactBook {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  ownerEmployeeId String   @unique @map("owner_employee_id") @db.Uuid
  scope           String   @default("personal") @db.VarChar(16)
  visibleTo       Json     @default("[]") @map("visible_to")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner           Employee @relation(fields: [ownerEmployeeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scope])
  @@map("ContactBooks")
}

// Personal phone book for a human employee (POC). Later: ownerEmployeeId null = business-wide.
// Row share/assign: scope/visible_to + addedById — same co-share vs הטלה rules as list items.
model Contact {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  ownerEmployeeId    String   @map("owner_employee_id") @db.Uuid
  name               String   @db.VarChar(100)
  /** Primary routable phone; null = phoneless (retrievable, not routable). */
  phone              String?  @db.VarChar(32)
  /** Optional free-text note (תיאור) — not used for routing. */
  description        String?  @db.VarChar(500)
  kind               String   @default("personal") @db.VarChar(32)
  addedById          String?  @map("added_by_id") @db.Uuid
  scope              String   @default("personal") @db.VarChar(16)
  visibleTo          Json     @default("[]") @map("visible_to")
  /** Extra numbers + Meta card fields; never drop on merge. */
  extras             Json?
  /** Provenance when imported from lists.contacts (source row retained). */
  migratedFromItemId String?  @map("migrated_from_item_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner              Employee @relation(fields: [ownerEmployeeId], references: [id], onDelete: Cascade)

  @@unique([ownerEmployeeId, phone])
  @@index([userId])
  @@index([ownerEmployeeId, name])
  @@index([scope])
  attachmentLinks AttachmentLink[]

  @@index([migratedFromItemId])
  @@map("Contacts")
}

/// Static MOT GTFS generation (staging → active | failed; prior active → retired).
/// Queries read only status=active. Incomplete staging never activates.
model GtfsFeedGeneration {
  id            String    @id @default(uuid()) @db.Uuid
  status        String    @db.VarChar(16)
  sourceLabel   String?   @map("source_label") @db.VarChar(255)
  feedStartDate String?   @map("feed_start_date") @db.VarChar(8)
  feedEndDate   String?   @map("feed_end_date") @db.VarChar(8)
  errorMessage  String?   @map("error_message") @db.Text
  activatedAt   DateTime? @map("activated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  stops         GtfsStop[]
  agencies      GtfsAgency[]
  routes        GtfsRoute[]
  routeNetworks GtfsRouteNetwork[]
  trips         GtfsTrip[]
  stopTimes     GtfsStopTime[]
  calendarDates GtfsCalendarDate[]

  @@index([status])
  @@map("GtfsFeedGenerations")
}

model GtfsStop {
  generationId     String            @map("generation_id") @db.Uuid
  feedStopId       String            @map("feed_stop_id") @db.VarChar(64)
  stopCode         String            @map("stop_code") @db.VarChar(32)
  name             String            @db.VarChar(255)
  lat              Float
  lon              Float
  locationType     Int               @default(0) @map("location_type")
  parentFeedStopId String?           @map("parent_feed_stop_id") @db.VarChar(64)
  generation       GtfsFeedGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@id([generationId, feedStopId])
  @@index([generationId, stopCode])
  @@index([generationId, locationType])
  @@map("GtfsStops")
}

model GtfsAgency {
  generationId String             @map("generation_id") @db.Uuid
  agencyId     String             @map("agency_id") @db.VarChar(32)
  name         String             @db.VarChar(255)
  generation   GtfsFeedGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@id([generationId, agencyId])
  @@index([generationId, name])
  @@map("GtfsAgencies")
}

model GtfsRoute {
  generationId String             @map("generation_id") @db.Uuid
  feedRouteId  String             @map("feed_route_id") @db.VarChar(64)
  agencyId     String             @map("agency_id") @db.VarChar(32)
  shortName    String             @map("short_name") @db.VarChar(64)
  longName     String             @default("") @map("long_name") @db.VarChar(255)
  generation   GtfsFeedGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@id([generationId, feedRouteId])
  @@index([generationId, shortName])
  @@index([generationId, agencyId])
  @@map("GtfsRoutes")
}

/// MOT RouteNetworksByDate overlay (Direction / OfficeLineId / AgencyName).
model GtfsRouteNetwork {
  id            String             @id @default(uuid()) @db.Uuid
  generationId  String             @map("generation_id") @db.Uuid
  feedRouteId   String             @map("feed_route_id") @db.VarChar(64)
  officeLineId  String             @default("") @map("office_line_id") @db.VarChar(64)
  lineId        String             @default("") @map("line_id") @db.VarChar(64)
  direction     String             @default("") @db.VarChar(16)
  agencyId      String             @default("") @map("agency_id") @db.VarChar(32)
  agencyName    String             @default("") @map("agency_name") @db.VarChar(255)
  generation    GtfsFeedGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([generationId, feedRouteId])
  @@index([generationId, officeLineId])
  @@index([generationId, lineId, direction])
  @@map("GtfsRouteNetworks")
}

model GtfsTrip {
  generationId String             @map("generation_id") @db.Uuid
  feedTripId   String             @map("feed_trip_id") @db.VarChar(64)
  feedRouteId  String             @map("feed_route_id") @db.VarChar(64)
  serviceId    String             @map("service_id") @db.VarChar(32)
  directionId  Int?               @map("direction_id")
  headsign     String             @default("") @db.VarChar(255)
  generation   GtfsFeedGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@id([generationId, feedTripId])
  @@index([generationId, serviceId, feedRouteId, directionId])
  @@index([generationId, feedRouteId])
  @@map("GtfsTrips")
}

model GtfsStopTime {
  generationId  String             @map("generation_id") @db.Uuid
  feedTripId    String             @map("feed_trip_id") @db.VarChar(64)
  stopSequence  Int                @map("stop_sequence")
  feedStopId    String             @map("feed_stop_id") @db.VarChar(64)
  arrivalTime   String             @default("") @map("arrival_time") @db.VarChar(16)
  departureTime String             @map("departure_time") @db.VarChar(16)
  /// Seconds since service-day midnight; may exceed 86400 for after-midnight GTFS times.
  depSeconds    Int                @map("dep_seconds")
  generation    GtfsFeedGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@id([generationId, feedTripId, stopSequence])
  @@index([generationId, feedStopId, depSeconds])
  @@index([generationId, feedTripId])
  @@map("GtfsStopTimes")
}

model GtfsCalendarDate {
  generationId String             @map("generation_id") @db.Uuid
  serviceId    String             @map("service_id") @db.VarChar(32)
  date         String             @db.VarChar(8)
  exceptionType Int               @map("exception_type")
  generation   GtfsFeedGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@id([generationId, serviceId, date])
  @@index([generationId, date])
  @@map("GtfsCalendarDates")
}

/**
 * Cold WhatsApp invite: asker cannot free-form message a number with no 24h
 * session. Speaker forwards a personal wa.me draft; recipient opens business
 * chat via token and must register before the check continues.
 */
model WhatsAppInvite {
  id                 String    @id @default(uuid()) @db.Uuid
  /** Opaque code embedded in business wa.me prefilled text (WRK-INV-…). */
  token              String    @unique @db.VarChar(32)
  userId             String    @map("user_id") @db.Uuid
  askerEmployeeId    String    @map("asker_employee_id") @db.Uuid
  digitalEmployeeId  String    @map("digital_employee_id") @db.Uuid
  recipientPhone     String    @map("recipient_phone") @db.VarChar(32)
  recipientLabel     String    @map("recipient_label") @db.VarChar(100)
  askSummary         String    @map("ask_summary") @db.VarChar(500)
  /** Full draft the asker forwards to the recipient (includes business link). */
  draftText          String    @map("draft_text") @db.Text
  /** pending | consumed | expired */
  status             String    @default("pending") @db.VarChar(16)
  guestEmployeeId    String?   @map("guest_employee_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  consumedAt         DateTime? @map("consumed_at")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([recipientPhone, status])
  @@index([guestEmployeeId])
  @@map("WhatsAppInvites")
}
